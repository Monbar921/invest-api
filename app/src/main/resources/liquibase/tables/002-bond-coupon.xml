<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="INVEST-XXX-create-bond-coupon-table" author="d.v.kornilovich">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bond_coupon"/>
            </not>
        </preConditions>

        <createTable tableName="bond">
            <column autoIncrement="true" name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="bond_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_bond_coupon_bond_id" references="bond(id)"/>
            </column>
            <column name="quantity_per_year" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="numeric(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar2(3)">
                <constraints nullable="false"/>
            </column>
            <column name="fix_date" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="payment_date" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="created_by" type="varchar(200)"/>
            <column name="updated_at" type="timestamp"/>
            <column name="updated_by" type="varchar(200)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
