<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <!-- позиция портфеля пользователя: одна покупка облигации. Облигация - по тикеру, без внешнего ключа:
         облигации пересоздаются синхронизацией. Одну облигацию можно купить несколькими покупками -->
    <changeSet id="INVEST-001-create-portfolio-position-table" author="d.v.kornilovich">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="portfolio_position"/>
            </not>
        </preConditions>

        <createTable tableName="portfolio_position">
            <column autoIncrement="true" name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ticker" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="int">
                <constraints nullable="false"/>
            </column>
            <!-- цена покупки, % от номинала -->
            <column name="buy_price" type="numeric(10, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="buy_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp"/>
        </createTable>

        <createIndex tableName="portfolio_position" indexName="portfolio_position_user_idx">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <!-- брокеры пользователя: список для выбора у покупки. Брокер остаётся, даже если покупок с ним больше нет -
         его можно выбрать у следующих покупок. Имя уникально у пользователя без учёта регистра -->
    <changeSet id="INVEST-001-create-portfolio-broker-table" author="d.v.kornilovich">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="portfolio_broker"/>
            </not>
        </preConditions>

        <createTable tableName="portfolio_broker">
            <column autoIncrement="true" name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>create unique index portfolio_broker_user_name_uq_idx on portfolio_broker (user_id, lower(name))</sql>

        <!-- брокер у покупки необязателен -->
        <addColumn tableName="portfolio_position">
            <column name="broker_id" type="bigint"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="portfolio_position" baseColumnNames="broker_id"
                                 constraintName="fk_portfolio_position_broker_id"
                                 referencedTableName="portfolio_broker" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
    </changeSet>
</databaseChangeLog>
