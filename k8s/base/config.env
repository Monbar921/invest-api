# Переменные окружения приложения, общие для всех окружений.
# Отличия окружения переопределяются в overlays/<окружение>/kustomization.yaml (configMapGenerator, behavior: merge)
SPRING_CACHE_TYPE=caffeine
INVEST_ENABLED=true
# в application.yml шедулеры выключены, в кластере включаем: ночная цепочка и частое обновление цен
RU_INVEST_API_STOCK_SUPPLIER_SCHEDULER_SYNC_ENABLED=true
RU_INVEST_API_STOCK_SUPPLIER_SCHEDULER_PRICE_ENABLED=true
SPRING_CLOUD_OPENFEIGN_CLIENT_CONFIG_CB_RF_CLIENT_URL=https://www.cbr.ru/
SPRING_CLOUD_OPENFEIGN_CLIENT_CONFIG_BUDGET_ORG_CLIENT_URL=https://api.budjet.org/
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized
